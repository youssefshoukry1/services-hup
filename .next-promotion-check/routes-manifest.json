{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/services/[service_name]",
      "regex": "^/services/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPservice_name": "nxtPservice_name"
      },
      "namedRegex": "^/services/(?<nxtPservice_name>[^/]+?)(?:/)?$"
    },
    {
      "page": "/services/[service_name]/[company_id]",
      "regex": "^/services/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPservice_name": "nxtPservice_name",
        "nxtPcompany_id": "nxtPcompany_id"
      },
      "namedRegex": "^/services/(?<nxtPservice_name>[^/]+?)/(?<nxtPcompany_id>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/add-company",
      "regex": "^/add\\-company(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/add\\-company(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/submissions",
      "regex": "^/admin/submissions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/submissions(?:/)?$"
    },
    {
      "page": "/cards_sevices_section",
      "regex": "^/cards_sevices_section(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cards_sevices_section(?:/)?$"
    },
    {
      "page": "/dienstleister",
      "regex": "^/dienstleister(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dienstleister(?:/)?$"
    },
    {
      "page": "/hero_section",
      "regex": "^/hero_section(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/hero_section(?:/)?$"
    },
    {
      "page": "/refrence_components/card_refrence",
      "regex": "^/refrence_components/card_refrence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/refrence_components/card_refrence(?:/)?$"
    },
    {
      "page": "/service_id_page",
      "regex": "^/service_id_page(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/service_id_page(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}